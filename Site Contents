<script>
  const slides = document.querySelectorAll('.background-slide');
  const dots = document.querySelectorAll('.hero-slideshow .slide-dot');
  const slideshow = document.querySelector('.hero'); let currentSlide = 0;
  const contactForm = document.getElementById('contactForm');
  const formStatus = document.getElementById('formStatus');
  const inquiryRibbon = document.getElementById('inquiryRibbon');   const inquiryRibbonExpiresAt = Date.parse('2026-10-12T22:38:18Z');
  

  if (Date.now() < inquiryRibbonExpiresAt) {
    inquiryRibbon.hidden = false;
    window.setTimeout(() => { inquiryRibbon.hidden = true; }, inquiryRibbonExpiresAt - Date.now());
  }

  contactForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const submitButton = contactForm.querySelector('[type="submit"]');
    const formData = Object.fromEntries(new FormData(contactForm));
    submitButton.disabled = true;
    formStatus.classList.remove('error');
    formStatus.textContent = 'Sending your message…';

    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 15000);

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: {
          Accept: 'application/json',
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(formData),
        signal: controller.signal
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || result.success === false || result.success === 'false') {
        throw new Error('send-failed');
      }
      contactForm.reset();
      formStatus.textContent = 'Thanks! Your message was sent. I’ll get back to you soon.';
    } catch (error) {
      // The form service is unreachable — fall back to the customer's email app
      // with everything they typed already filled in.
      const body = [
        `Name: ${formData.name || ''}`,
        `Business: ${formData.business || ''}`,
        `Email: ${formData.email || ''}`,
        '',
        formData.message || ''
      ].join('\n');
      const mailto = 'mailto:jgwebsitebuilds@gmail.com'
        + '?subject=' + encodeURIComponent('New website project inquiry')
        + '&body=' + encodeURIComponent(body);
      formStatus.classList.add('error');
      formStatus.innerHTML = 'The form couldn’t send right now, so I opened your email app with your message filled in — just hit send. '
        + 'If nothing opened, email <a href="' + mailto + '">jgwebsitebuilds@gmail.com</a> or call (951)-234-1683.';
      window.location.href = mailto;
    } finally {
      clearTimeout(timeout);
      submitButton.disabled = false;
    }
  });

  function showSlide(index) {
    currentSlide = (index + slides.length) % slides.length;
    slides.forEach((slide, slideIndex) => slide.classList.toggle('active', slideIndex === currentSlide));
    dots.forEach((dot, dotIndex) => {
      const isActive = dotIndex === currentSlide;
      dot.classList.toggle('active', isActive);
      dot.toggleAttribute('aria-current', isActive);
    });
  }

  document.querySelectorAll('[data-slide-direction]').forEach((button) => {
    button.addEventListener('click', () => showSlide(currentSlide + (button.dataset.slideDirection === 'next' ? 1 : -1)));
  });
  dots.forEach((dot, dotIndex) => dot.addEventListener('click', () => showSlide(dotIndex)));

  let slideshowTimer = setInterval(() => showSlide(currentSlide + 1), 5000);
  slideshow.addEventListener('mouseenter', () => clearInterval(slideshowTimer));
  slideshow.addEventListener('mouseleave', () => {
    slideshowTimer = setInterval(() => showSlide(currentSlide + 1), 5000);
  });
  const clientLogoSlides = document.querySelectorAll('[data-client-slide]'); const clientLogoDots = document.querySelectorAll('[data-client-slide-to]'); const clientShowcase = document.querySelector('.client-showcase'); let currentClientSlide = 0; function showClientLogo(index) { currentClientSlide = (index + clientLogoSlides.length) % clientLogoSlides.length; clientLogoSlides.forEach((slide, slideIndex) => { const isActive = slideIndex === currentClientSlide; slide.classList.toggle('active', isActive); slide.setAttribute('aria-hidden', String(!isActive)); }); clientLogoDots.forEach((dot, dotIndex) => { const isActive = dotIndex === currentClientSlide; dot.classList.toggle('active', isActive); if (isActive) dot.setAttribute('aria-current', 'true'); else dot.removeAttribute('aria-current'); }); } document.querySelectorAll('[data-client-direction]').forEach((button) => { button.addEventListener('click', () => showClientLogo(currentClientSlide + (button.dataset.clientDirection === 'next' ? 1 : -1))); }); clientLogoDots.forEach((dot, dotIndex) => dot.addEventListener('click', () => showClientLogo(dotIndex))); const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches; let clientLogoTimer; const stopClientLogoSlideshow = () => window.clearInterval(clientLogoTimer); const startClientLogoSlideshow = () => { stopClientLogoSlideshow(); if (!prefersReducedMotion) clientLogoTimer = window.setInterval(() => showClientLogo(currentClientSlide + 1), 5000); }; clientShowcase.addEventListener('mouseenter', stopClientLogoSlideshow); clientShowcase.addEventListener('mouseleave', startClientLogoSlideshow); clientShowcase.addEventListener('focusin', stopClientLogoSlideshow); clientShowcase.addEventListener('focusout', (event) => { if (!clientShowcase.contains(event.relatedTarget)) startClientLogoSlideshow(); }); startClientLogoSlideshow(); </script>
