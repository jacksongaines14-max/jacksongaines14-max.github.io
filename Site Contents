<script>
  const slides = document.querySelectorAll('.background-slide');
  const dots = document.querySelectorAll('.slide-dot');
  const slideshow = document.querySelector('.hero');
  let currentSlide = 0;

  function showSlide(index) {
    currentSlide = (index + slides.length) % slides.length;
    slides.forEach((slide, slideIndex) => slide.classList.toggle('active', slideIndex === currentSlide));
    dots.forEach((dot, dotIndex) => {
      const isActive = dotIndex === currentSlide;
      dot.classList.toggle('active', isActive);
      dot.toggleAttribute('aria-current', isActive);
    });
  }

  document.querySelectorAll('[data-slide-direction]').forEach((button) => {
    button.addEventListener('click', () => showSlide(currentSlide + (button.dataset.slideDirection === 'next' ? 1 : -1)));
  });
  dots.forEach((dot, dotIndex) => dot.addEventListener('click', () => showSlide(dotIndex)));

  let slideshowTimer = setInterval(() => showSlide(currentSlide + 1), 5000);
  slideshow.addEventListener('mouseenter', () => clearInterval(slideshowTimer));
  slideshow.addEventListener('mouseleave', () => {
    slideshowTimer = setInterval(() => showSlide(currentSlide + 1), 5000);
  });
</script>
